# GitHub Models API Key
# Preferred: set one token and it will be used for both models.
GITHUB_TOKEN=github_pat_xxxxxxxxxxxxx
# Optional advanced mode: override per model.
# GITHUB_TOKEN_A=github_pat_xxxxxxxxxxxxx
# GITHUB_TOKEN_B=github_pat_xxxxxxxxxxxxx

# GitHub Models Base URL
GITHUB_MODELS_BASE_URL=https://models.github.ai/inference

# ChromaDB Configuration
CHROMA_PERSIST_DIR=./chroma_storage
CHROMA_COLLECTION_NAME=intellisearch_v2_corpus

# Security
CLIENT_KEY=your-secret-client-key-change-in-production

# Model Names
GPT4O_MODEL=gpt-4o
LLAMA_MODEL=Meta-Llama-3.1-405B-Instruct

# Retrieval Parameters
TOP_K_RETRIEVAL=15
SIMILARITY_THRESHOLD=0.70

# Chunking Parameters
CHUNK_SIZE=512
CHUNK_OVERLAP=64
